# Agentic Research and Portfolio Maker: runtime settings (NOT paths).
# All folder and file paths live in config/paths.json.
# setup.sh copies this to config/arpm.env (if missing). Do not commit config/arpm.env.

# Ollama runs on the same machine.
OLLAMA_HOST=http://localhost:11434

# Admin tab password. Set a real value before starting the app.
ARPM_ADMIN_PASSWORD=

# API keys for optional providers. Leave empty to keep everything local.
# The Admin tab stores only the NAME of the variable, never the key.
HF_TOKEN=
EXTERNAL_API_KEY=
